---
import meta from '../content/meta.json';
---
<div class="wrap" aria-label="GitHub engineering snapshot">
  <div class="stats">
    {meta.stats.map((stat) => (
      <div class="stat">
        <div class="stat-value">{stat.value}</div>
        <div class="stat-label">{stat.label}</div>
      </div>
    ))}
  </div>
</div>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: rgba(255,255,255,.018); box-shadow: var(--shadow); }
  .stat { min-height: 144px; padding: 25px 26px; border-right: 1px solid var(--line); }
  .stat:last-child { border-right: 0; }
  .stat-value { font-size: clamp(30px, 4vw, 44px); line-height: 1; letter-spacing: -.045em; font-weight: 800; }
  .stat-label { margin-top: 13px; color: var(--muted); font-size: 13px; }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2,1fr); }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 680px) {
    .stats { grid-template-columns: 1fr; }
    .stat { border-right: 0; border-bottom: 1px solid var(--line) !important; }
    .stat:last-child { border-bottom: 0 !important; }
  }
  @media print {
    .stats {
      grid-template-columns: repeat(4, 1fr); margin-top: 5mm; border-color: #cbd5e1;
      background: #ffffff !important; box-shadow: none !important;
      break-inside: avoid; page-break-inside: avoid;
    }
    .stat { padding: 3.5mm 3mm; border-color: #cbd5e1 !important; }
    .stat-value { font-size: 17pt; color: #111111 !important; }
    .stat-label { font-size: 7.5pt; color: #4b5563 !important; }
  }
</style>
