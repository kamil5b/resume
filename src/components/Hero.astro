---
import meta from '../content/meta.json';
---
<section class="hero" id="top">
  <div class="wrap">
    <div class="eyebrow"><span class="dot" aria-hidden="true"></span> {meta.eyebrow}</div>
    <h1>{meta.name}.</h1>
    <h1><span class="dim">I build systems that ship.</span></h1>
    <div class="hero-grid">
      <div>
        <p class="lede">{meta.bio}</p>
        <div class="print-only print-meta">{meta.printMeta}</div>
        <div class="hero-actions no-print">
          <a class="btn btn-primary" href="#experience">View experience ↓</a>
          <a class="btn btn-secondary" href={meta.github} target="_blank" rel="noreferrer">@kamil5b on GitHub ↗</a>
          <a class="btn btn-secondary" href={meta.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </div>
      <aside class="hero-note" aria-label="Portfolio note">
        <strong>Public detail, private discretion.</strong>
        Private repository evidence is represented only as anonymized engineering scope and technology experience.
      </aside>
    </div>
  </div>
</section>

<style>
  .hero { padding: 104px 0 72px; }
  h1 {
    margin: 18px 0 24px; max-width: 970px; font-size: clamp(48px, 8vw, 100px); line-height: .96; letter-spacing: -.065em;
    font-weight: 820;
  }
  h1 .dim { color: #69736f; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, .7fr); gap: 48px; align-items: end; }
  .lede { max-width: 760px; color: #c5cfcb; font-size: clamp(18px, 2vw, 22px); letter-spacing: -.015em; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .hero-note {
    padding: 18px 0 4px 22px; border-left: 1px solid var(--line); color: var(--muted); font-size: 14px;
  }
  .hero-note strong { display: block; margin-bottom: 4px; color: var(--text); font-size: 15px; }

  @media (max-width: 900px) {
    .hero { padding-top: 78px; }
    .hero-grid { grid-template-columns: 1fr; gap: 18px; }
    .hero-note { margin-top: 8px; }
  }
  @media (max-width: 680px) {
    h1 { font-size: clamp(46px, 17vw, 74px); }
    .hero { padding: 66px 0 56px; }
  }
  @media print {
    .hero { padding: 0 0 7mm; border-bottom: 1px solid #aeb7c2; }
    .hero-grid { grid-template-columns: 1.5fr .7fr; gap: 7mm; }
    h1 { margin-top: 4mm; font-size: 27pt; line-height: 1.02; letter-spacing: -.04em; }
    .dim { color: #4b5563 !important; }
    .lede { max-width: none; margin-bottom: 0; font-size: 10pt; color: #242b33 !important; }
    .hero-note {
      margin: 0; padding: 4mm; border: 1px solid #cbd5e1;
      background: #ffffff !important; color: #4b5563 !important; box-shadow: none !important;
      break-inside: avoid; page-break-inside: avoid;
    }
    .hero-note strong { color: #111111 !important; }
  }
</style>
