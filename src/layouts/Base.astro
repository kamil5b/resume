---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Muhammad Haykal Kamil — Technical Lead, Backend Engineer & Data Scientist building Go systems, full-stack products, developer tools, LLM-powered applications, and applied AI/ML systems." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a0d0f" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
